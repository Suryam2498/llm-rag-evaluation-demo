# Copy to .env (never commit .env). Credentials come from `aws configure` or AWS_* environment variables.
LLM_PROVIDER=bedrock
AWS_REGION=us-east-1
# Use a model that is available in your account and region (check the Bedrock console).
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0
# Optional: a different (stronger) model for the judge
# JUDGE_MODEL_ID=
